# Скопируй этот файл в .env и при необходимости поправь значения.
# Формат: postgresql://ПОЛЬЗОВАТЕЛЬ:ПАРОЛЬ@ХОСТ:ПОРТ/ИМЯ_БАЗЫ
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kr_tests

# Откуда разрешено ходить фронтенду (CORS). Через запятую, если адресов несколько.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# --- Генерация заданий через ИИ (AITUNNEL, OpenAI-совместимый API) ---
# Ключ пустой → кнопка «Сгенерировать» скрыта, остаётся ручной путь (скопировать промт).
# Ключ живёт только на сервере: на фронт он не уходит и в логи не пишется.
AI_API_BASE_URL=https://api.aitunnel.ru/v1
# Если основной адрес недоступен из сети школы — зеркало: https://ru-api.aitunnel.ru/v1
AI_API_KEY=
# Модель, которая составляет задания.
AI_MODEL=qwen3.7-plus
# Модель самопроверки: решает каждое задание заново, не видя ответа. Пусто → AI_MODEL.
AI_CHECK_MODEL=gpt-5-mini
# Уходит в запросы самопроверки как reasoning_effort. Пусто → не передаётся.
# Если провайдер отвергнет параметр, запрос повторится без него.
AI_CHECK_REASONING_EFFORT=low
# max_tokens уходит в КАЖДОМ запросе: по нему провайдер резервирует стоимость.
AI_GEN_MAX_TOKENS=4000
AI_CHECK_MAX_TOKENS=1500
AI_TIMEOUT_SECONDS=120
# Паузы (в секундах) перед повторами временных сбоев: обрыв связи, таймаут, 429, 5xx.
# Сколько чисел — столько повторов; действует и для генерации, и для самопроверки.
AI_RETRY_PAUSES=2,5,10
# Сколько запросов к ИИ одновременно (генерация и самопроверка вместе).
# Больше — быстрее, но провайдер может начать отвечать «слишком много запросов».
AI_MAX_CONCURRENCY=6
# Размышления модели при генерации: off — не размышлять (быстрее и дешевле), on — как
# решит провайдер. Если модель не умеет отключать размышления, запрос повторится без
# этого параметра, а в логе появится предупреждение.
AI_GEN_THINKING=off
# Сколько вариантов одного умения просить одним запросом (если ответ не влезает
# в AI_GEN_MAX_TOKENS, сервер сам возьмёт меньше).
AI_GEN_CHUNK_VARIANTS=4

# --- Почта: приглашения учителям и «забыли пароль» ---
# SMTP_HOST пустой → тестовый режим: письма не отправляются, а пишутся в лог сервера
# и в журнал писем; в админке плашка «Почта не настроена — ссылки копируйте вручную».
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
# Пароль (для Яндекса и Mail.ru — «пароль приложения»). В логи не попадает.
SMTP_PASSWORD=
# Адрес отправителя. Пусто → SMTP_USER.
SMTP_FROM=
SMTP_FROM_NAME="Проверочные работы · Школа 2090"
# true — порт 465 (шифрование сразу); false — порт 587 (STARTTLS).
SMTP_SSL=true
# Как сервис называет себя почтовому серверу (EHLO). Только латиница: имя
# компьютера с кириллицей («Учительская-ПК») ломает соединение.
SMTP_LOCAL_HOSTNAME=localhost
# Сколько секунд ждать почтовый сервер на каждом шаге. Дольше — письмо получает
# статус «не ушло» с причиной, а не висит «отправляется».
SMTP_TIMEOUT_SECONDS=30
# Адрес сайта, как его открывает учитель: из него собираются ссылки в письмах.
PUBLIC_BASE_URL=http://127.0.0.1:5174
