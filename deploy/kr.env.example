# =====================================================================
# Образец файла env/kr.env на сервере.
#
# Скопируйте его в /opt/2090-fun-infra/env/kr.env и подставьте свои значения.
# Настоящих паролей здесь нет и быть не должно: файл лежит в репозитории.
#
# На сервере ограничьте доступ к файлу:
#     chmod 600 env/kr.env
#
# Файл читают два сервиса: kr-postgres (создаёт базу) и kr-backend
# (подключается к ней). Поэтому имя базы, пользователь и пароль описаны
# и по отдельности, и одной строкой DATABASE_URL — они должны совпадать.
# =====================================================================

# ---------------------------------------------------------------------
# База данных
# ---------------------------------------------------------------------

KR_POSTGRES_DB=kr_tests
KR_POSTGRES_USER=kr_user
# Придумайте длинный пароль, например: openssl rand -base64 24
KR_POSTGRES_PASSWORD=ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ

# Строка подключения для бэкенда.
# Хост — это имя сервиса из docker-compose.yml (kr-postgres), а не localhost:
# внутри своей сети контейнеры находят друг друга по именам.
# Пароль должен совпадать с KR_POSTGRES_PASSWORD выше.
DATABASE_URL=postgresql://kr_user:ЗАМЕНИТЕ_НА_ДЛИННЫЙ_ПАРОЛЬ@kr-postgres:5432/kr_tests

# ---------------------------------------------------------------------
# Безопасность
# ---------------------------------------------------------------------

# Cookie с входом передаётся только по https. На сервере за Caddy — обязательно
# true, иначе cookie можно перехватить в школьной сети.
COOKIE_SECURE=true

# Доверять заголовку X-Forwarded-For, который ставит Caddy.
# Нужно, чтобы ограничение подбора пароля видело настоящий адрес ученика,
# а не адрес прокси. Включать ТОЛЬКО когда сервис закрыт прокси — так и есть:
# портов наружу у контейнеров нет.
TRUST_PROXY=true

# Разрешённые адреса для запросов из браузера (CORS).
# Фронтенд и API живут на одном домене, поэтому CORS фактически не нужен,
# но список оставляем на случай, если фронт когда-нибудь вынесут отдельно.
CORS_ORIGINS=https://kr.2090.fun

# Автодокументация /docs и /redoc. На публичном сервере лучше false:
# она перечисляет все эндпоинты, а пользы посетителям не приносит.
DOCS_ENABLED=false

# ---------------------------------------------------------------------
# Прочее
# ---------------------------------------------------------------------

# Часовой пояс контейнеров: от него зависит время сдачи работ в выгрузке Excel.
TZ=Europe/Moscow
