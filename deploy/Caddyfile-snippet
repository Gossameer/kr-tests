# =====================================================================
# Заготовка для Caddyfile контейнера edge-caddy.
#
# Добавьте блок целиком рядом с блоками других сайтов. Сертификат для домена
# Caddy получит сам при первом обращении — от вас нужен только A-запись
# kr.2090.fun на IP сервера.
#
# Порядок внутри блока важен: Caddy проверяет handle-правила сверху вниз,
# поэтому сначала идут точные пути к API, а «всё остальное» — последним.
# =====================================================================

kr.2090.fun {
	# Общие заголовки безопасности и строгая CSP — те же, что у соседних
	# сервисов. Сервис ничего не грузит с чужих доменов: скриптов из CDN нет,
	# поэтому CSP ничего не сломает.
	#
	# Формулы (KaTeX) собраны вместе с приложением: скрипт, стили и шрифты
	# лежат в /assets на этом же домене. Им достаточно строгой политики:
	#     default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'
	# 'unsafe-inline' для стилей НЕ нужен (KaTeX выставляет стили из скрипта),
	# шрифты отдаются файлами, а не data:. Проверено в браузере с такой политикой.
	# Если в csp_default задан font-src без 'self' (например, 'none') — формулы
	# останутся читаемыми, но знаки будут системным шрифтом: добавьте 'self'.
	import security_headers
	import csp_default
	import hidden_files

	# --- API ---------------------------------------------------------
	# Всё, что начинается с /api/, уходит бэкенду как есть: он сам ждёт
	# адреса вида /api/auth/login. Путь не переписываем.
	handle /api/* {
		reverse_proxy kr-backend:8000
	}

	# Проверка живости бэкенда — удобно дёргать снаружи при разборе аварии.
	handle /health {
		reverse_proxy kr-backend:8000
	}

	# --- Фронтенд ----------------------------------------------------
	# Всё остальное отдаёт nginx с собранным приложением. Он же возвращает
	# index.html на адреса вида /tests/12/results, которых нет на диске.
	handle {
		reverse_proxy kr-frontend:80
	}
}
